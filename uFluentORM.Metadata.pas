unit uFluentORM.Metadata;

interface

uses
  System.Rtti,
  System.SysUtils,
  System.TypInfo,
  System.Generics.Collections;

type
  TOrmPropertyMeta = record
    PropertyInfo: TRttiProperty;
    PropertyName: string;
    ColumnName: string;
    IsKey: Boolean;
    IsAutoGenerated: Boolean;
    IsIgnored: Boolean;
    IsReadOnly: Boolean;
  end;

  TOrmEntityMeta = class
  private
    FEntityClass: TClass;
    FTableName: string;
    FProperties: TArray<TOrmPropertyMeta>;
    FKeyPropertyIndex: Integer;
  public
    constructor Create(AEntityClass: TClass; const ATableName: string;
      const AProperties: TArray<TOrmPropertyMeta>; AKeyPropertyIndex: Integer);

    property EntityClass: TClass read FEntityClass;
    property TableName: string read FTableName;
    property Properties: TArray<TOrmPropertyMeta> read FProperties;
    property KeyPropertyIndex: Integer read FKeyPropertyIndex;
    function HasKey: Boolean;
    function KeyProperty: TOrmPropertyMeta;
  end;

  TOrmMetadataCache = class
  private
    class var FCache: TObjectDictionary<TClass, TOrmEntityMeta>;
    class var FLock: TObject;
    class var FRttiContext: TRttiContext;
    class function BuildEntityMeta(AClass: TClass): TOrmEntityMeta; static;
    class function ResolveTableName(AType: TRttiType): string; static;
    class function ResolveColumnName(AProp: TRttiProperty): string; static;
  public
    class constructor Create;
    class destructor Destroy;
    class function GetEntityMeta(AClass: TClass): TOrmEntityMeta; static;
    class procedure Clear; static;
  end;

implementation

uses
  uFluentORM.Attributes;

{ TOrmEntityMeta }

constructor TOrmEntityMeta.Create(AEntityClass: TClass; const ATableName: string;
  const AProperties: TArray<TOrmPropertyMeta>; AKeyPropertyIndex: Integer);
begin
  inherited Create;
  FEntityClass := AEntityClass;
  FTableName := ATableName;
  FProperties := AProperties;
  FKeyPropertyIndex := AKeyPropertyIndex;
end;

function TOrmEntityMeta.HasKey: Boolean;
begin
  Result := FKeyPropertyIndex >= 0;
end;

function TOrmEntityMeta.KeyProperty: TOrmPropertyMeta;
begin
  if not HasKey then
    raise Exception.CreateFmt('Entity %s has no [Key] property.',
      [EntityClass.ClassName]);
  Result := FProperties[FKeyPropertyIndex];
end;

{ TOrmMetadataCache }

class constructor TOrmMetadataCache.Create;
begin
  FRttiContext := TRttiContext.Create;
  FCache := TObjectDictionary<TClass, TOrmEntityMeta>.Create([doOwnsValues]);
  FLock := TObject.Create;
end;

class destructor TOrmMetadataCache.Destroy;
begin
  FCache.Free;
  FLock.Free;
  FRttiContext.Free;
end;

class procedure TOrmMetadataCache.Clear;
begin
  TMonitor.Enter(FLock);
  try
    FCache.Clear;
  finally
    TMonitor.Exit(FLock);
  end;
end;

class function TOrmMetadataCache.GetEntityMeta(AClass: TClass): TOrmEntityMeta;
begin
  TMonitor.Enter(FLock);
  try
    if not FCache.TryGetValue(AClass, Result) then
    begin
      Result := BuildEntityMeta(AClass);
      FCache.Add(AClass, Result);
    end;
  finally
    TMonitor.Exit(FLock);
  end;
end;

class function TOrmMetadataCache.ResolveTableName(AType: TRttiType): string;
var
  Attr: TCustomAttribute;
begin
  Result := AType.Name;
  for Attr in AType.GetAttributes do
    if Attr is TableAttribute then
      Exit(TableAttribute(Attr).Name);
end;

class function TOrmMetadataCache.ResolveColumnName(AProp: TRttiProperty): string;
var
  Attr: TCustomAttribute;
begin
  Result := AProp.Name;
  for Attr in AProp.GetAttributes do
    if Attr is ColumnAttribute then
      Exit(ColumnAttribute(Attr).Name);
end;

class function TOrmMetadataCache.BuildEntityMeta(AClass: TClass): TOrmEntityMeta;
var
  RttiType: TRttiType;
  RttiProp: TRttiProperty;
  PropMeta: TOrmPropertyMeta;
  Props: TList<TOrmPropertyMeta>;
  Attr: TCustomAttribute;
  IsIgnored: Boolean;
  IsReadOnly: Boolean;
  IsKey: Boolean;
  IsAutoGenerated: Boolean;
  KeyIndex: Integer;
  ConventionalKeyIndex: Integer;
begin
  RttiType := FRttiContext.GetType(AClass);
  if RttiType = nil then
    raise Exception.CreateFmt('RTTI not found for class %s.', [AClass.ClassName]);

  Props := TList<TOrmPropertyMeta>.Create;
  try
    KeyIndex := -1;
    ConventionalKeyIndex := -1;
    for RttiProp in RttiType.GetProperties do
    begin
      if RttiProp.Parent <> RttiType then
        Continue;

      if not RttiProp.IsReadable then
        Continue;

      IsIgnored := False;
      IsReadOnly := not RttiProp.IsWritable;
      IsKey := False;
      IsAutoGenerated := True;

      for Attr in RttiProp.GetAttributes do
      begin
        if Attr is IgnoreAttribute then
          IsIgnored := True
        else if Attr is ReadOnlyAttribute then
          IsReadOnly := True
        else if Attr is KeyAttribute then
        begin
          IsKey := True;
          IsAutoGenerated := KeyAttribute(Attr).AutoGenerated;
        end;
      end;

      if IsIgnored then
        Continue;

      PropMeta.PropertyInfo := RttiProp;
      PropMeta.PropertyName := RttiProp.Name;
      PropMeta.ColumnName := ResolveColumnName(RttiProp);
      PropMeta.IsKey := IsKey;
      PropMeta.IsAutoGenerated := IsAutoGenerated;
      PropMeta.IsIgnored := IsIgnored;
      PropMeta.IsReadOnly := IsReadOnly;

      if IsKey then
      begin
        if KeyIndex >= 0 then
          raise Exception.CreateFmt('Entity %s has more than one [Key].',
            [AClass.ClassName]);
        KeyIndex := Props.Count;
      end;

      if SameText(RttiProp.Name, 'Id') then
        ConventionalKeyIndex := Props.Count;

      Props.Add(PropMeta);
    end;

    if (KeyIndex < 0) and (ConventionalKeyIndex >= 0) then
    begin
      KeyIndex := ConventionalKeyIndex;
      PropMeta := Props[KeyIndex];
      PropMeta.IsKey := True;
      PropMeta.IsAutoGenerated := True;
      Props[KeyIndex] := PropMeta;
    end;

    Result := TOrmEntityMeta.Create(
      AClass,
      ResolveTableName(RttiType),
      Props.ToArray,
      KeyIndex
    );
  finally
    Props.Free;
  end;
end;

end.
