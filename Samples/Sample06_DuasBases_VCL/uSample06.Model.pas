unit uSample06.Model;

{ Modelo compartilhado pelas duas bases do Sample06.

  - TClienteDTO: UMA classe para MySQL e PostgreSQL. O TRepository<T> cuida das
    diferencas (aspas, tipos, chave gerada com LAST_INSERT_ID x RETURNING).
  - DDL de criacao da tabela por dialeto.
  - TLoggingExecutor: decorator de ISQLExecutor que registra o SQL com o nome da
    base ([A] / [B]), para ver no log o que cada conexao executou.
  - PreloadVendorLib: localiza e carrega libmysql.dll / libpq.dll. }

interface

uses
  System.SysUtils,
  System.Variants,
  System.IOUtils,
  Data.DB,
  uFluentORM.Types,
  uFluentORM.Attributes,
  uFluentORM.Executor,
  uFluentORM.Executor.FireDAC;

type
  [Table('cliente')]
  TClienteDTO = class
  private
    FId: Integer;
    FNome: string;
    FEmail: string;
    FCpf: string;
    FDataNascimento: Variant;
    FLimiteCredito: Currency;
    FAtivo: Boolean;
    FOrigem: string;
    FCriadoEm: TDateTime;
  public
    constructor Create;
    /// Copia os dados (sem Id e sem colunas preenchidas pelo banco).
    procedure AssignData(ASource: TClienteDTO);

    [Key(True)]
    [Column('id')]
    property Id: Integer read FId write FId;

    [Column('nome')]
    property Nome: string read FNome write FNome;

    [Column('email')]
    property Email: string read FEmail write FEmail;

    [Column('cpf')]
    property Cpf: string read FCpf write FCpf;

    // Variant pode ser NULL. O tipo explicito (ftDate) e necessario no
    // PostgreSQL: sem ele um NULL iria como texto e a coluna DATE o rejeitaria.
    [Column('data_nascimento', ftDate)]
    property DataNascimento: Variant read FDataNascimento write FDataNascimento;

    [Column('limite_credito')]
    property LimiteCredito: Currency read FLimiteCredito write FLimiteCredito;

    [Column('ativo')]
    property Ativo: Boolean read FAtivo write FAtivo;

    // Qual base gerou o registro (ajuda a ver as copias entre bases).
    [Column('origem')]
    property Origem: string read FOrigem write FOrigem;

    [ReadOnly]
    [Column('criado_em')]
    property CriadoEm: TDateTime read FCriadoEm write FCriadoEm;
  end;

  TLogProc = procedure(const AText: string) of object;

  TLoggingExecutor = class(TInterfacedObject, ISQLExecutor, ISQLQueryExecutor,
    ISQLDialectInfo, ISQLTransactionalExecutor, ISQLIdentityExecutor)
  private
    FInner: TFireDACSQLExecutor;
    FInnerRef: ISQLExecutor;
    FPrefix: string;
    FLog: TLogProc;
    procedure DoLog(const AText: string);
    procedure LogCommand(const ASQL: string; const AParams: TSQLParams);
    class function ParamText(const AValue: Variant): string; static;
  public
    constructor Create(AInner: TFireDACSQLExecutor; const APrefix: string; ALog: TLogProc);
    function Execute(const ASQL: string; const AParams: TSQLParams): Integer;
    function ExecuteScalar(const ASQL: string; const AParams: TSQLParams): Variant;
    function OpenDataSet(const ASQL: string; const AParams: TSQLParams): TDataSet;
    function GetDatabaseType: TSQLDatabaseType;
    function GetLastInsertedId: Variant;
    procedure BeginTransaction;
    procedure Commit;
    procedure Rollback;
    function InTransaction: Boolean;
  end;

/// DDL da tabela cliente para o dialeto informado.
function CreateTableSQL(ADatabaseType: TSQLDatabaseType): string;

/// Nome amigavel do dialeto.
function DatabaseCaption(ADatabaseType: TSQLDatabaseType): string;

/// Localiza e pre-carrega a DLL cliente (libmysql.dll ou libpq.dll).
/// Retorna o caminho carregado ou '' (motivo enviado para ALog).
function PreloadVendorLib(ADatabaseType: TSQLDatabaseType; ALog: TLogProc): string;

implementation

uses
  Winapi.Windows;

{ TClienteDTO }

constructor TClienteDTO.Create;
begin
  inherited Create;
  FAtivo := True;
  FDataNascimento := Null;
end;

procedure TClienteDTO.AssignData(ASource: TClienteDTO);
begin
  FNome := ASource.Nome;
  FEmail := ASource.Email;
  FCpf := ASource.Cpf;
  FDataNascimento := ASource.DataNascimento;
  FLimiteCredito := ASource.LimiteCredito;
  FAtivo := ASource.Ativo;
  FOrigem := ASource.Origem;
end;

{ DDL }

function CreateTableSQL(ADatabaseType: TSQLDatabaseType): string;
begin
  case ADatabaseType of
    dbPostgreSQL:
      Result :=
        'CREATE TABLE IF NOT EXISTS cliente (' + sLineBreak +
        '  id              INTEGER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,' + sLineBreak +
        '  nome            VARCHAR(100)  NOT NULL,' + sLineBreak +
        '  email           VARCHAR(120)  NULL,' + sLineBreak +
        '  cpf             VARCHAR(14)   NULL,' + sLineBreak +
        '  data_nascimento DATE          NULL,' + sLineBreak +
        '  limite_credito  NUMERIC(12,2) NOT NULL DEFAULT 0,' + sLineBreak +
        '  ativo           BOOLEAN       NOT NULL DEFAULT TRUE,' + sLineBreak +
        '  origem          VARCHAR(40)   NULL,' + sLineBreak +
        '  criado_em       TIMESTAMP     NOT NULL DEFAULT CURRENT_TIMESTAMP' + sLineBreak +
        ')';
  else // dbMySQL
    Result :=
      'CREATE TABLE IF NOT EXISTS cliente (' + sLineBreak +
      '  id              INT AUTO_INCREMENT PRIMARY KEY,' + sLineBreak +
      '  nome            VARCHAR(100)  NOT NULL,' + sLineBreak +
      '  email           VARCHAR(120)  NULL,' + sLineBreak +
      '  cpf             VARCHAR(14)   NULL,' + sLineBreak +
      '  data_nascimento DATE          NULL,' + sLineBreak +
      '  limite_credito  DECIMAL(12,2) NOT NULL DEFAULT 0,' + sLineBreak +
      '  ativo           TINYINT(1)    NOT NULL DEFAULT 1,' + sLineBreak +
      '  origem          VARCHAR(40)   NULL,' + sLineBreak +
      '  criado_em       DATETIME      NOT NULL DEFAULT CURRENT_TIMESTAMP' + sLineBreak +
      ') ENGINE=InnoDB DEFAULT CHARSET=utf8mb4';
  end;
end;

function DatabaseCaption(ADatabaseType: TSQLDatabaseType): string;
begin
  case ADatabaseType of
    dbMySQL: Result := 'MySQL';
    dbPostgreSQL: Result := 'PostgreSQL';
    dbMSSQL: Result := 'SQL Server';
    dbFirebird: Result := 'Firebird';
    dbSQLite: Result := 'SQLite';
  else
    Result := 'Generico';
  end;
end;

{ DLLs cliente }

function ProgramFiles64: string;
begin
  // ProgramFiles pode vir como "Program Files (x86)" quando o exe e iniciado
  // pela IDE; ProgramW6432 aponta sempre para "C:\Program Files".
  Result := System.SysUtils.GetEnvironmentVariable('ProgramW6432');
  if Result = '' then
    Result := System.SysUtils.GetEnvironmentVariable('ProgramFiles');
end;

function TryLoad(const ALib, ADepsDir: string; ALog: TLogProc): Boolean;
var
  H: HMODULE;
begin
  Result := False;
  if not FileExists(ALib) then
    Exit;
  if ADepsDir <> '' then
    SetDllDirectory(PChar(ADepsDir));
  try
    // LOAD_WITH_ALTERED_SEARCH_PATH: as dependencias sao procuradas primeiro
    // na pasta da propria DLL.
    H := LoadLibraryEx(PChar(ALib), 0, LOAD_WITH_ALTERED_SEARCH_PATH);
  finally
    if ADepsDir <> '' then
      SetDllDirectory(nil);
  end;
  if H = 0 then
  begin
    if Assigned(ALog) then
      ALog('Falha ao carregar ' + ALib + ': ' + SysErrorMessage(GetLastError));
    Exit;
  end;
  Result := True;
end;

function PreloadVendorLib(ADatabaseType: TSQLDatabaseType; ALog: TLogProc): string;
var
  ExeDir, Root, LibName, Lib: string;
  Dirs: TArray<string>;
  I: Integer;
begin
  Result := '';
  ExeDir := ExtractFilePath(ParamStr(0));
  case ADatabaseType of
    dbMySQL: LibName := 'libmysql.dll';
    dbPostgreSQL: LibName := 'libpq.dll';
  else
    Exit;
  end;

  // 1) Pasta do executavel (ou subpasta lib).
  Lib := TPath.Combine(ExeDir, LibName);
  if TryLoad(Lib, '', ALog) then
    Exit(Lib);
  Lib := TPath.Combine(ExeDir, 'lib\' + LibName);
  if TryLoad(Lib, '', ALog) then
    Exit(Lib);

  // 2) Instalacao do servidor (versao mais nova primeiro).
  if ADatabaseType = dbMySQL then
    Root := TPath.Combine(ProgramFiles64, 'MySQL')
  else
    Root := TPath.Combine(ProgramFiles64, 'PostgreSQL');

  if TDirectory.Exists(Root) then
  begin
    Dirs := TDirectory.GetDirectories(Root);
    for I := High(Dirs) downto Low(Dirs) do
    begin
      if ADatabaseType = dbMySQL then
      begin
        // MySQL: DLL em "lib", dependencias (OpenSSL) em "bin".
        Lib := TPath.Combine(Dirs[I], 'lib\libmysql.dll');
        if TryLoad(Lib, TPath.Combine(Dirs[I], 'bin'), ALog) then
          Exit(Lib);
        Lib := TPath.Combine(Dirs[I], 'bin\libmysql.dll');
        if TryLoad(Lib, '', ALog) then
          Exit(Lib);
      end
      else
      begin
        // PostgreSQL: libpq.dll e dependencias juntas em "bin".
        Lib := TPath.Combine(Dirs[I], 'bin\libpq.dll');
        if TryLoad(Lib, '', ALog) then
          Exit(Lib);
      end;
    end;
  end;

  if Assigned(ALog) then
    ALog(Format('%s nao encontrada. Copie a %s (64 bits) e suas dependencias ' +
      'para a pasta do executavel.', [LibName, LibName]));
end;

{ TLoggingExecutor }

constructor TLoggingExecutor.Create(AInner: TFireDACSQLExecutor;
  const APrefix: string; ALog: TLogProc);
begin
  inherited Create;
  FInner := AInner;
  FInnerRef := AInner;
  FPrefix := APrefix;
  FLog := ALog;
end;

procedure TLoggingExecutor.DoLog(const AText: string);
begin
  if Assigned(FLog) then
    FLog(FPrefix + ' ' + AText);
end;

class function TLoggingExecutor.ParamText(const AValue: Variant): string;
begin
  if VarIsNull(AValue) or VarIsEmpty(AValue) then
    Result := 'NULL'
  else if VarIsArray(AValue) then
    Result := '<blob>'
  else if VarIsStr(AValue) then
    Result := QuotedStr(VarToStr(AValue))
  else
    Result := VarToStr(AValue);
end;

procedure TLoggingExecutor.LogCommand(const ASQL: string; const AParams: TSQLParams);
var
  S: string;
  P: TSQLParam;
begin
  S := ASQL;
  for P in AParams do
    S := S + '  [:' + P.Name + '=' + ParamText(P.Value) + ']';
  DoLog(S);
end;

function TLoggingExecutor.Execute(const ASQL: string; const AParams: TSQLParams): Integer;
begin
  LogCommand(ASQL, AParams);
  Result := FInner.Execute(ASQL, AParams);
end;

function TLoggingExecutor.ExecuteScalar(const ASQL: string; const AParams: TSQLParams): Variant;
begin
  LogCommand(ASQL, AParams);
  Result := FInner.ExecuteScalar(ASQL, AParams);
end;

function TLoggingExecutor.OpenDataSet(const ASQL: string; const AParams: TSQLParams): TDataSet;
begin
  LogCommand(ASQL, AParams);
  Result := FInner.OpenDataSet(ASQL, AParams);
end;

function TLoggingExecutor.GetDatabaseType: TSQLDatabaseType;
begin
  Result := FInner.GetDatabaseType;
end;

function TLoggingExecutor.GetLastInsertedId: Variant;
begin
  Result := FInner.GetLastInsertedId;
end;

procedure TLoggingExecutor.BeginTransaction;
begin
  DoLog('BEGIN');
  FInner.BeginTransaction;
end;

procedure TLoggingExecutor.Commit;
begin
  DoLog('COMMIT');
  FInner.Commit;
end;

procedure TLoggingExecutor.Rollback;
begin
  DoLog('ROLLBACK');
  FInner.Rollback;
end;

function TLoggingExecutor.InTransaction: Boolean;
begin
  Result := FInner.InTransaction;
end;

end.
