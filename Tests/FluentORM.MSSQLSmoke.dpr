program FluentORM.MSSQLSmoke;

{$APPTYPE CONSOLE}

uses
  System.SysUtils,
  System.Classes,
  System.DateUtils,
  System.Variants,
  uFluentORM.Types,
  uFluentORM.Attributes,
  uFluentORM.Executor,
  uFluentORM,
  uFluentORM.Repository;

type
  [Table('fluentorm_smoke')]
  TSmokeUsuario = class
  private
    FId: Integer;
    FNome: string;
    FEmail: string;
    FAtivo: Boolean;
    FCriadoEm: TDateTime;
  public
    [Key(True)]
    [Column('id')]
    property Id: Integer read FId write FId;

    [Column('nome')]
    property Nome: string read FNome write FNome;

    [Column('email')]
    property Email: string read FEmail write FEmail;

    [Column('ativo')]
    property Ativo: Boolean read FAtivo write FAtivo;

    [Column('criado_em')]
    property CriadoEm: TDateTime read FCriadoEm write FCriadoEm;
  end;

  TCaptureExecutor = class(TInterfacedObject, ISQLExecutor, ISQLDialectInfo, ISQLIdentityExecutor)
  private
    FSQL: string;
  public
    function Execute(const ASQL: string; const AParams: TSQLParams): Integer;
    function ExecuteScalar(const ASQL: string; const AParams: TSQLParams): Variant;
    function GetDatabaseType: TSQLDatabaseType;
    function GetLastInsertedId: Variant;
    property SQL: string read FSQL;
  end;

function TCaptureExecutor.Execute(const ASQL: string; const AParams: TSQLParams): Integer;
begin
  FSQL := ASQL;
  Result := 1;
end;

function TCaptureExecutor.ExecuteScalar(const ASQL: string; const AParams: TSQLParams): Variant;
begin
  FSQL := ASQL;
  Result := 1;
end;

function TCaptureExecutor.GetDatabaseType: TSQLDatabaseType;
begin
  Result := dbMSSQL;
end;

function TCaptureExecutor.GetLastInsertedId: Variant;
begin
  Result := Null;
end;

// Replaces the parameter markers produced by the repository with literals so
// the statement can be executed directly by sqlcmd. FireDAC binds these
// parameters in real usage; here we only validate the SQL Server syntax.
function WithLiterals(const ASQL: string): string;
var
  S: string;
begin
  S := ASQL;
  S := StringReplace(S, ':p_nome', 'N''Ana''', [rfReplaceAll]);
  S := StringReplace(S, ':p_email', 'N''ana@example.com''', [rfReplaceAll]);
  S := StringReplace(S, ':p_ativo', '1', [rfReplaceAll]);
  S := StringReplace(S, ':p_criado_em', '''2024-05-01T10:30:00.000''', [rfReplaceAll]);
  S := StringReplace(S, ':k_id', '1', [rfReplaceAll]);
  Result := S;
end;

var
  Lines: TStringList;
  SQL: TSQLBuilder;
  Union1, Union2: TSQLBuilder;
  Fake: TCaptureExecutor;
  FakeIntf: ISQLExecutor;
  Repo: TRepository<TSmokeUsuario>;
  U: TSmokeUsuario;

  procedure AddSQL(const AComment, ASQL: string);
  begin
    Lines.Add('-- ' + AComment);
    Lines.Add(ASQL);
    Lines.Add('GO');
    Lines.Add('');
  end;

begin
  Lines := TStringList.Create;
  SQL := TSQLBuilder.Create;
  Union1 := TSQLBuilder.Create;
  Union2 := TSQLBuilder.Create;
  Fake := TCaptureExecutor.Create;
  FakeIntf := Fake;
  Repo := TRepository<TSmokeUsuario>.Create(FakeIntf);
  U := TSmokeUsuario.Create;
  try
    Lines.Add('-- Generated by FluentORM.MSSQLSmoke. Do not edit.');
    Lines.Add('SET NOCOUNT ON;');
    Lines.Add('GO');
    Lines.Add('');
    Lines.Add('IF OBJECT_ID(''tempdb..fluentorm_smoke'') IS NOT NULL DROP TABLE fluentorm_smoke;');
    Lines.Add('GO');
    Lines.Add('');
    Lines.Add('CREATE TABLE fluentorm_smoke (');
    Lines.Add('  id INT IDENTITY(1,1) PRIMARY KEY,');
    Lines.Add('  nome NVARCHAR(100) NULL,');
    Lines.Add('  email NVARCHAR(100) NULL,');
    Lines.Add('  ativo BIT NULL,');
    Lines.Add('  criado_em DATETIME2 NULL');
    Lines.Add(');');
    Lines.Add('GO');
    Lines.Add('');
    // A trigger makes "OUTPUT INSERTED.x" (without INTO) fail with error 334.
    // The repository uses "OUTPUT ... INTO @fluent_ids", which must succeed here.
    Lines.Add('CREATE TRIGGER trg_fluentorm_smoke ON fluentorm_smoke AFTER INSERT AS');
    Lines.Add('BEGIN SET NOCOUNT ON; END;');
    Lines.Add('GO');
    Lines.Add('');

    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    SQL.UseNamedParams := False;

    // SET NOCOUNT ON; DECLARE @fluent_ids ...; INSERT ... OUTPUT INSERTED.<pk> INTO @fluent_ids ...; SELECT
    U.Nome := 'Ana';
    U.Email := 'ana@example.com';
    U.Ativo := True;
    U.CriadoEm := EncodeDateTime(2024, 5, 1, 10, 30, 0, 0);
    Repo.Insert(U);
    AddSQL('Repository insert (OUTPUT INSERTED INTO @fluent_ids, table with trigger)', WithLiterals(Trim(Fake.SQL)));

    // Repository update/delete/count
    U.Id := 1;
    U.Nome := 'Ana Maria';
    Repo.Update(U);
    AddSQL('Repository update', WithLiterals(Trim(Fake.SQL)));

    Repo.Count;
    AddSQL('Repository count', Trim(Fake.SQL));

    Repo.DeleteById(1);
    AddSQL('Repository delete', WithLiterals(Trim(Fake.SQL)));

    // Builder pagination with explicit ORDER BY
    AddSQL('Pagination with ORDER BY',
      SQL.Select.Fields(['id', 'nome']).From('fluentorm_smoke')
        .Where('ativo', True).OrderByAsc('nome').Paginate(2, 10).ToSQL);

    // Builder pagination without ORDER BY (injected ORDER BY)
    SQL.Clear;
    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    AddSQL('Pagination without ORDER BY',
      SQL.Select.All.From('fluentorm_smoke').Limit(5).ToSQL);

    // Date literal
    SQL.Clear;
    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    SQL.UseNamedParams := False;
    AddSQL('Date literal',
      SQL.Select.Fields(['id']).From('fluentorm_smoke')
        .Where('criado_em', EncodeDate(2024, 1, 15), opGreaterOrEqual).ToSQL);

    // Counts
    SQL.Clear;
    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    SQL.UseNamedParams := False;
    AddSQL('Distinct count',
      SQL.SelectDistinct.Fields(['nome']).From('fluentorm_smoke').ToSQLCount);

    SQL.Clear;
    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    AddSQL('Grouped count',
      SQL.Select.Fields(['nome', 'COUNT(*)']).From('fluentorm_smoke')
        .GroupBy('nome').ToSQLCount);

    // UNION with pagination
    Union1.SetDatabaseType(dbMSSQL);
    Union1.QuoteIdentifiers := True;
    Union2.SetDatabaseType(dbMSSQL);
    Union2.QuoteIdentifiers := True;
    Union1.Select.Fields(['id']).From('fluentorm_smoke');
    Union2.Select.Fields(['id']).From('fluentorm_smoke');
    Union1.Union(Union2).Limit(5);
    AddSQL('Union with pagination', Union1.ToSQL);

    // Recursive CTE (MSSQL omits RECURSIVE)
    SQL.Clear;
    SQL.SetDatabaseType(dbMSSQL);
    SQL.QuoteIdentifiers := True;
    SQL.StrictMode := False;
    AddSQL('Recursive CTE',
      SQL.Select.All.From('arvore')
        .WithRecursiveCTE('arvore',
          'SELECT 1 AS id UNION ALL SELECT id + 1 FROM arvore WHERE id < 5')
        .ToSQL);

    Lines.Add('SELECT COUNT(*) AS rows_after_insert FROM fluentorm_smoke;');
    Lines.Add('GO');
    Lines.Add('');
    Lines.Add('DROP TABLE fluentorm_smoke;');
    Lines.Add('GO');
    Lines.Add('');

    Lines.SaveToFile(ParamStr(1));
    Writeln('Wrote ', ParamStr(1));
  finally
    U.Free;
    Repo.Free;
    FakeIntf := nil;
    Union1.Free;
    Union2.Free;
    SQL.Free;
    Lines.Free;
  end;
end.
